# Add these entries to ~/docker/stacks/apps/.env; preserve all existing values.
# CONFIG_ROOT and TRAEFIK_NET already exist there and are reused.
UMAMI_HOST=analytics.jmistry.com

# Generate separately on the host: openssl rand -hex 24
UMAMI_DB_PASSWORD=
# Generate separately on the host: openssl rand -hex 32
UMAMI_APP_SECRET=

NEXT_PUBLIC_SITE_URL=https://jmistry.com
NEXT_PUBLIC_FORMSPREE_ID=xwvgkeda
# The site proxies the tracker from Umami under /stats (next.config.ts), so
# visitors never contact analytics.jmistry.com and it can stay private.
NEXT_PUBLIC_UMAMI_SRC=/stats/script.js
# Leave empty until you create jmistry.com in Umami, then paste its website ID.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
