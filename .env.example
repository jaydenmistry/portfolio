# Formspree form ID for the contact form. The default ("xwvgkeda") is baked
# into lib/data.ts; set this only to override it at build time, e.g. to point
# staging at a different form.
NEXT_PUBLIC_FORMSPREE_ID=

# Base URL used to build robots.txt and sitemap.xml entries. Defaults to
# https://jmistry.com when unset.
NEXT_PUBLIC_SITE_URL=https://jmistry.com

# Full URL of the self-hosted Umami tracker script, e.g.
# https://analytics.jmistry.com/script.js. Leave empty to disable analytics;
# the layout only renders the tracker when this and the website ID are both set.
NEXT_PUBLIC_UMAMI_SRC=

# Website ID shown in the Umami dashboard under Settings > Websites. Leave empty
# to disable analytics (the default for local dev and CI builds).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
